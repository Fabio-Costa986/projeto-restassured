{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ListaUsuarios",
  "type": "object",
  "required": ["quantidade", "usuarios"],
  "properties": {
    "quantidade": { "type": "integer", "minimum": 0 },
    "usuarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["_id", "nome", "email", "password", "administrador"],
        "properties": {
          "_id":           { "type": "string" },
          "nome":          { "type": "string" },
          "email":         { "type": "string" },
          "password":      { "type": "string" },
          "administrador": { "type": "string" }
        }
      }
    }
  }
}
